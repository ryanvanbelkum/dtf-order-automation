<ContentDialog
    x:Class="DtfOrderAutomation.Dialogs.DateRangeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Get Orders"
    PrimaryButtonText="Run"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="16" MinWidth="380" MaxWidth="480">

        <!-- ── Mode selector ────────────────────────────────────────────── -->
        <StackPanel Spacing="8">
            <TextBlock Text="DATE RANGE"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       CharacterSpacing="50"/>

            <RadioButton x:Name="CustomRangeRadio"
                         Content="Custom date &amp; time range"
                         GroupName="DateMode"
                         IsChecked="True"
                         Checked="RadioChanged"/>

            <RadioButton x:Name="SinceLastRunRadio"
                         GroupName="DateMode"
                         Checked="RadioChanged">
                <StackPanel Spacing="1">
                    <TextBlock Text="Since last run"/>
                    <TextBlock x:Name="LastRunHint"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="AllOrdersRadio"
                         Content="All unfulfilled (no date filter)"
                         GroupName="DateMode"
                         Checked="RadioChanged"/>
        </StackPanel>

        <!-- ── Custom date/time pickers ─────────────────────────────────── -->
        <StackPanel x:Name="CustomPanel" Spacing="12">

            <!-- From -->
            <StackPanel Spacing="6">
                <TextBlock Text="FROM"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           CharacterSpacing="50"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CalendarDatePicker x:Name="FromDate"
                                        PlaceholderText="Pick a date"
                                        Width="175"/>
                    <TimePicker x:Name="FromTime"
                                ClockIdentifier="12HourClock"/>
                </StackPanel>
            </StackPanel>

            <!-- To -->
            <StackPanel Spacing="6">
                <TextBlock Text="TO"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           CharacterSpacing="50"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CalendarDatePicker x:Name="ToDate"
                                        PlaceholderText="Leave blank for now"
                                        Width="175"/>
                    <TimePicker x:Name="ToTime"
                                ClockIdentifier="12HourClock"/>
                </StackPanel>
                <TextBlock Text="Leave the end date blank to fetch up to right now."
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Quick presets -->
            <StackPanel Spacing="6">
                <TextBlock Text="QUICK PRESETS"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           CharacterSpacing="50"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Yesterday 6pm → Now"
                            Click="Preset_Yesterday6pmToNow"/>
                    <Button Content="Today midnight → Now"
                            Click="Preset_TodayMidnightToNow"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>

    </StackPanel>
</ContentDialog>
