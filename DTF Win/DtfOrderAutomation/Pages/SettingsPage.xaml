<Page
    x:Class="DtfOrderAutomation.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,24" Spacing="12" MaxWidth="600">

            <!-- Shopify Store URL -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="SHOPIFY STORE URL"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <TextBox x:Name="StoreUrlBox" PlaceholderText="e.g. mystore.myshopify.com"/>
                    <TextBlock Text="Your .myshopify.com domain (no https://)"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Client ID -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="SHOPIFY CLIENT ID"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <TextBox x:Name="ClientIdBox" PlaceholderText="Client ID from Dev Dashboard → Settings"/>
                </StackPanel>
            </Border>

            <!-- Client Secret -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="SHOPIFY CLIENT SECRET"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <PasswordBox x:Name="ClientSecretBox" PlaceholderText="Client Secret"/>
                </StackPanel>
            </Border>

            <!-- Designs Folder -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="DESIGNS FOLDER"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 x:Name="DesignsFolderBox"
                                 PlaceholderText="Folder containing design PNG/JPG files"/>
                        <Button Grid.Column="1" Content="Browse…"
                                Click="BrowseDesignsFolder_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hot Folder -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="HOT FOLDER"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 x:Name="HotFolderBox"
                                 PlaceholderText="CADlink hot folder path"/>
                        <Button Grid.Column="1" Content="Browse…"
                                Click="BrowseHotFolder_Click"/>
                    </Grid>
                    <TextBlock Text="CADlink will automatically pick up files dropped here"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Version -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="ABOUT"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <TextBlock x:Name="VersionLabel"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Danger Zone -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#CC3333"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="DANGER ZONE"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#CC3333"
                               CharacterSpacing="50"/>
                    <TextBlock Text="Permanently deletes all mappings, synced products, and run history. Your credentials and folder paths will be kept."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <Button x:Name="ResetAllBtn"
                            Content="Reset All App Data"
                            Foreground="#CC3333"
                            Click="ResetAllBtn_Click"/>
                </StackPanel>
            </Border>

            <!-- Save button -->
            <Button Content="Save Settings"
                    HorizontalAlignment="Stretch"
                    Height="46"
                    FontSize="14" FontWeight="SemiBold"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveBtn_Click"/>

        </StackPanel>
    </ScrollViewer>
</Page>
