<Page
    x:Class="DtfOrderAutomation.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,24" Spacing="12" MaxWidth="640">

            <!-- ── Status / Run button ───────────────────────────────────── -->
            <Button x:Name="RunBtn"
                    HorizontalAlignment="Stretch"
                    Height="52"
                    FontSize="15" FontWeight="SemiBold"
                    Click="RunBtn_Click"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="RunBtnIcon" Glyph="&#xE768;" FontSize="16"/>
                    <TextBlock x:Name="RunBtnText" Text="Run Now"/>
                </StackPanel>
            </Button>

            <!-- ── Last Run ──────────────────────────────────────────────── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="LAST RUN"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <TextBlock x:Name="LastRunTime"
                               Text="Never"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LastRunSummary"
                               Text="No runs yet"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ── All-Time Stats ────────────────────────────────────────── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="ALL-TIME STATISTICS"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <!-- Total Runs -->
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="StatTotalRuns"
                                       Text="0"
                                       FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Runs"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- Total Orders -->
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="StatTotalOrders"
                                       Text="0"
                                       FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Orders"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- Total Files -->
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Name="StatTotalFiles"
                                       Text="0"
                                       FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Files Queued"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- Total Skipped -->
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock x:Name="StatTotalSkipped"
                                       Text="0"
                                       FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Skipped"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="StatSuccessRate"
                               Text=""
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
