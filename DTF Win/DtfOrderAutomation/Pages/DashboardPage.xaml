<Page
    x:Class="DtfOrderAutomation.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,24" Spacing="12" MaxWidth="640">

            <!-- ── Status / Run button ───────────────────────────────────── -->
            <Button x:Name="RunBtn"
                    HorizontalAlignment="Stretch"
                    Height="52"
                    FontSize="15" FontWeight="SemiBold"
                    Click="RunBtn_Click"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="RunBtnIcon" Glyph="&#xE768;" FontSize="16"/>
                    <TextBlock x:Name="RunBtnText" Text="Run Now"/>
                </StackPanel>
            </Button>

            <!-- ── Next Scheduled Run ────────────────────────────────────── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="NEXT SCHEDULED RUN"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <TextBlock x:Name="NextRunTime"
                               Text="—"
                               FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Countdown"
                               Text=""
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ── Last Run ──────────────────────────────────────────────── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="LAST RUN"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <TextBlock x:Name="LastRunTime"
                               Text="Never"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LastRunSummary"
                               Text="No runs yet"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ── Schedule controls ─────────────────────────────────────── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="16">
                    <TextBlock Text="SCHEDULE"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>

                    <!-- Interval stepper -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Run automatically every"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <Button Content="−" Width="32" Height="32"
                                Click="DecInterval_Click"/>
                        <TextBlock x:Name="IntervalDisplay"
                                   Text="1" Width="28" TextAlignment="Center"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="+" Width="32" Height="32"
                                Click="IncInterval_Click"/>
                        <TextBlock Text="hour(s)"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Enable/disable toggle -->
                    <ToggleSwitch x:Name="ScheduleSwitch"
                                  Header="Schedule enabled"
                                  Toggled="ScheduleSwitch_Toggled"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
