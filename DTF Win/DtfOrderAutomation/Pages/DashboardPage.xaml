<Page
    x:Class="DtfOrderAutomation.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,24" Spacing="12" MaxWidth="1080" HorizontalAlignment="Center">

            <!-- ── Status / Run button ───────────────────────────────────── -->
            <Button x:Name="RunBtn"
                    HorizontalAlignment="Stretch"
                    Height="52"
                    FontSize="15" FontWeight="SemiBold"
                    Click="RunBtn_Click"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="RunBtnIcon" Glyph="&#xE768;" FontSize="16"/>
                    <TextBlock x:Name="RunBtnText" Text="Run Now"/>
                </StackPanel>
            </Button>

            <!-- ── All-Time Stat Tiles ───────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="StatTotalRuns" Text="0"
                                   FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Runs" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="StatTotalOrders" Text="0"
                                   FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Orders Processed" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="StatTotalFiles" Text="0"
                                   FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Files Sent" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="StatTotalSkipped" Text="0"
                                   FontSize="28" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock Text="Skipped" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Recent Activity chart + Last Run ──────────────────────── -->
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">

                <!-- Recent Activity chart -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="RECENT ACTIVITY"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       CharacterSpacing="50"/>
                            <TextBlock Text="Orders per run — last 14 runs"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Chart area (bars built in code-behind) -->
                        <Grid Height="190">
                            <TextBlock x:Name="ChartEmpty"
                                       Text="No activity yet — run an order fetch to see your trend."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                            <Grid x:Name="ChartGrid" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Legend -->
                        <StackPanel x:Name="ChartLegend"
                                    Orientation="Horizontal" Spacing="16"
                                    Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="Processed" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{ThemeResource SystemFillColorCautionBrush}"/>
                                <TextBlock Text="Skipped" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Last Run + success rate -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="LAST RUN"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       CharacterSpacing="50"/>
                            <TextBlock x:Name="LastRunTime"
                                       Text="Never"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LastRunSummary"
                                       Text="No runs yet"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Border Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="SUCCESS RATE"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       CharacterSpacing="50"/>
                            <TextBlock x:Name="StatSuccessPct"
                                       Text="—"
                                       FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatSuccessRate"
                                       Text="No runs yet"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
