<Page
    x:Class="DtfOrderAutomation.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DtfOrderAutomation.Pages">

    <Grid RowDefinitions="Auto,*" Padding="12,8">

        <!-- Caption -->
        <TextBlock Grid.Row="0"
                   Text="Each run is listed below — expand a run to see its order items and what was sent to CadLink."
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="4,0,4,8"
                   TextWrapping="Wrap"/>

        <!-- History list -->
        <ListView Grid.Row="1"
                  x:Name="HistoryList"
                  ItemsSource="{x:Bind HistoryItems}"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:HistoryItem">
                    <Expander Margin="0,2"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">

                        <!-- ── Run summary (header) ───────────────────────── -->
                        <Expander.Header>
                            <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DateDisplay}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind SummaryLine}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind StatusBackground}"
                                        CornerRadius="10"
                                        Padding="10,3"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{x:Bind StatusDisplay}"
                                               FontSize="12"
                                               Foreground="{x:Bind StatusColor}"/>
                                </Border>
                            </Grid>
                        </Expander.Header>

                        <!-- ── Order items (content) ──────────────────────── -->
                        <StackPanel Spacing="1" Padding="0,4,0,4">

                            <TextBlock Text="No order items recorded for this run."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind EmptyHintVisibility}"
                                       Margin="4,4"/>

                            <ItemsControl ItemsSource="{x:Bind Details}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:HistoryDetailRow">
                                        <Grid ColumnDefinitions="*,56,1.4*,Auto"
                                              Padding="6,7" Margin="0,1"
                                              ColumnSpacing="8">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Product}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Size}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind File}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="3"
                                                    Background="{x:Bind StatusBackground}"
                                                    CornerRadius="10"
                                                    Padding="9,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StatusText}"
                                                           FontSize="11"
                                                           Foreground="{x:Bind StatusColor}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Page>
