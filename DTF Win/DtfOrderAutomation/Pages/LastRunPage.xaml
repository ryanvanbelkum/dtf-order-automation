<Page
    x:Class="DtfOrderAutomation.Pages.LastRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*" Padding="8">

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="ClearBtn" Content="Clear" Click="ClearBtn_Click"/>
        </StackPanel>

        <!-- Log output -->
        <ScrollViewer Grid.Row="1"
                      x:Name="LogScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="LogText"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="12"
                       TextWrapping="NoWrap"
                       IsTextSelectionEnabled="True"
                       Padding="12"/>
        </ScrollViewer>

    </Grid>
</Page>
