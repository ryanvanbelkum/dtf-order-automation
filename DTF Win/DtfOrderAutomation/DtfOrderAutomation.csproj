<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DtfOrderAutomation</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Visual C++ Runtime DLLs, redistributed app-local so customers never need to
         install the VC++ Redistributable separately. Required by native Windows App
         SDK components; not included by WindowsAppSDKSelfContained. -->
    <None Include="Redist\vcruntime140.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>vcruntime140.dll</Link>
    </None>
    <None Include="Redist\vcruntime140_1.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>vcruntime140_1.dll</Link>
    </None>
    <None Include="Redist\msvcp140.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>msvcp140.dll</Link>
    </None>
  </ItemGroup>

  <!-- Windows App SDK 1.8 regression: compiled XAML (.xbf) files and the app's own
       resource index (DtfOrderAutomation.pri) land in the regular build output but are
       dropped from `dotnet publish` output for unpackaged apps. Missing .xbf causes
       XamlParseException loading page markup; missing .pri causes XamlParseException
       resolving ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml (the app has no
       resource map to route framework theme resources through). See
       https://github.com/microsoft/microsoft-ui-xaml/issues/10803. Copy both over
       manually until the SDK fixes it. -->
  <Target Name="CopyGeneratedXamlResourcesToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <XbfFiles Include="$(OutDir)**\*.xbf" />
      <PriFiles Include="$(OutDir)*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(XbfFiles)"
          DestinationFiles="@(XbfFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PriFiles)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
