<Page
    x:Class="DtfOrderAutomation.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,24" Spacing="12" MaxWidth="600">

            <!-- Shopify Store URL -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="SHOPIFY STORE URL"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <TextBox x:ConnectionId='10' x:Name="StoreUrlBox" PlaceholderText="e.g. mystore.myshopify.com"/>
                    <TextBlock Text="Your .myshopify.com domain (no https://)"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Client ID -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="SHOPIFY CLIENT ID"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <TextBox x:ConnectionId='9' x:Name="ClientIdBox" PlaceholderText="Client ID from Dev Dashboard → Settings"/>
                </StackPanel>
            </Border>

            <!-- Client Secret -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="SHOPIFY CLIENT SECRET"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <PasswordBox x:ConnectionId='8' x:Name="ClientSecretBox" PlaceholderText="Client Secret"/>
                </StackPanel>
            </Border>

            <!-- Designs Folder -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="DESIGNS FOLDER"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:ConnectionId='6' Grid.Column="0"
                                 x:Name="DesignsFolderBox"
                                 PlaceholderText="Folder containing design PNG/JPG files"/>
                        <Button x:ConnectionId='7' Grid.Column="1" Content="Browse…"
                                                                 />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hot Folder -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="HOT FOLDER"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:ConnectionId='4' Grid.Column="0"
                                 x:Name="HotFolderBox"
                                 PlaceholderText="CADlink hot folder path"/>
                        <Button x:ConnectionId='5' Grid.Column="1" Content="Browse…"
                                                             />
                    </Grid>
                    <TextBlock Text="CADlink will automatically pick up files dropped here"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Version -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="ABOUT"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               CharacterSpacing="50"/>
                    <TextBlock x:ConnectionId='3' x:Name="VersionLabel"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Save button -->
            <Button x:ConnectionId='2' Content="Save Settings"
                    HorizontalAlignment="Stretch"
                    Height="46"
                    FontSize="14" FontWeight="SemiBold"
                    Style="{StaticResource AccentButtonStyle}"
                                         />

        </StackPanel>
    </ScrollViewer>
</Page>

